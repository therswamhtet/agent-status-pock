{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "MessageDisplay": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "$HOME/.agentbridge/hooks/agentbridge-hook.py claude", "timeout": 5 } ] }
    ]
  }
}
